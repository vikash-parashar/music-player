    <string name="pro_you_have">உங்களிடம் Ampli Pro உள்ளது</string>
    <string name="pro_thanks">எல்லாம் நிரந்தரமாக அன்லாக் ஆகிவிட்டது. Ampli க்கு ஆதரவு தந்ததற்கு நன்றி!</string>
    <string name="pro_pitch">ஒருமுறை பணம் செலுத்துங்கள், என்றும் உங்களுடையது. மாதக் கட்டணம் இல்லை, இந்த Google கணக்கு உள்ள எல்லா போன்களிலும்.</string>
    <string name="pro_feature_no_ads">விளம்பரமே இல்லை</string>
    <string name="pro_feature_videos">கேமரா கிளிப்கள், டவுன்லோடுகளுக்கான வீடியோ பிளேயர்</string>
    <string name="pro_feature_cast">Chromecast மூலம் TV அல்லது ஸ்பீக்கரில் இயக்குங்கள்</string>
    <string name="pro_feature_recognize">பாடலைக் கண்டுபிடி: சுற்றிலும் ஒலிக்கும் பாடல் எது என்று அறியுங்கள்</string>
    <string name="pro_feature_recognize_soon">பாடலைக் கண்டுபிடி: சுற்றிலும் ஒலிக்கும் பாடல் எது என்று அறியுங்கள் (விரைவில்)</string>
    <string name="pro_get_for_price">%1$s க்கு Pro பெறுக</string>
    <string name="pro_get">Ampli Pro பெறுக</string>
    <string name="pro_display_price">₹199</string>
    <string name="pro_tagline">உங்கள் இசை, மாதக் கட்டணம் இல்லை. ஒருமுறை செலுத்துங்கள், என்றும் கேளுங்கள்.</string>
    <string name="pro_plan_lifetime">லைஃப்டைம் பிளான்</string>
