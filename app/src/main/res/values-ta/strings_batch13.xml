<resources>
    <string name="m3u_import">பிளேலிஸ்ட்டை இறக்குமதி செய் (M3U)</string>
    <string name="m3u_import_subtitle">வேறு பிளேயரிலிருந்து பிளேலிஸ்ட்டைக் கொண்டு வாருங்கள்</string>
    <string name="m3u_export">M3U ஆக ஏற்றுமதி செய்</string>
    <string name="m3u_exported">பிளேலிஸ்ட் சேமிக்கப்பட்டது</string>
    <string name="m3u_failed">பிளேலிஸ்ட்டைச் சேமிக்க முடியவில்லை</string>
    <string name="m3u_nothing_found">அந்த பிளேலிஸ்ட்டின் பாடல்கள் எதுவும் இந்த போனில் இல்லை</string>
    <string name="autoplay_title">ஹெட்ஃபோன் இணைந்ததும் இயக்கு</string>
    <string name="autoplay_desc">Ampli திறந்திருக்கும்போது அல்லது அறிவிப்பில் இடைநிறுத்தப்பட்டிருக்கும்போது, புளூடூத் இயர்பட்ஸ், கார் ஸ்டீரியோ அல்லது வயர் இயர்ஃபோன் இணைந்ததும் இசை தொடங்கும்.</string>
    <string name="prosound_title">Pro ஒலி</string>
    <string name="prosound_desc">10-பேண்ட் ஈக்வலைசர், பேஸ் பூஸ்ட் மற்றும் 3D சரவுண்ட்.</string>
    <string name="prosound_unlock">Pro மூலம் திற</string>
    <string name="prosound_unavailable">இந்த போன் இந்த ஒலி விளைவுகளை ஆதரிக்கவில்லை.</string>
    <string name="prosound_bass">பேஸ் பூஸ்ட்</string>
    <string name="prosound_surround">3D சரவுண்ட்</string>
    <string name="prosound_surround_hint">இயர்ஃபோனுடன் சிறப்பாக இருக்கும்.</string>
    <string name="prosound_preset_flat">சமநிலை</string>
    <string name="prosound_preset_bass">பேஸ்</string>
    <string name="prosound_preset_vocal">குரல்</string>
    <string name="prosound_preset_bollywood">பாலிவுட்</string>
    <string name="prosound_preset_rock">ராக்</string>
    <string name="prosound_preset_classical">கிளாசிக்கல்</string>
    <string name="prolook_title">Pro தோற்றம்</string>
    <string name="prolook_amoled">முழு கருப்பு</string>
    <string name="prolook_amoled_desc">டார்க் தீமில் கருப்பு பின்னணி. AMOLED திரைகளில் பேட்டரி சேமிக்கும்.</string>
    <string name="prolook_wallpaper">வால்பேப்பர் நிறங்கள்</string>
    <string name="prolook_wallpaper_desc">Ampli ரோஸ் நிறத்திற்குப் பதிலாக போன் வால்பேப்பர் நிறங்களைப் பயன்படுத்து.</string>
    <string name="invite_title">நண்பரிடம் சொல்லுங்கள்</string>
    <string name="invite_desc">Ampli பிடித்திருக்கிறதா? நண்பர்கள் மற்றும் குடும்பத்தினருடன் பகிருங்கள்.</string>
    <string name="invite_button">Ampli-ஐப் பகிர்</string>
    <string name="invite_message">மாதக் கட்டணம் இல்லாமல் என் இசையை Ampli-யில் கேட்கிறேன். நீங்களும் முயற்சிக்கவும்: %1$s</string>
    <string name="visualizer_title">விஷுவலைசர்</string>
    <string name="visualizer_bars">பார்கள்</string>
    <string name="visualizer_ring">வளையம்</string>
    <string name="visualizer_tap_hint">இயக்க அல்லது நிறுத்த எங்கும் தட்டவும்</string>
    <string name="pro_feature_sound">10-பேண்ட் ஈக்வலைசர்</string>
    <string name="pro_feature_sound_desc">பேஸ் பூஸ்ட் மற்றும் 3D சரவுண்ட், பாலிவுட் மற்றும் குரல் போன்ற முன்னமைவுகளுடன்.</string>
    <string name="pro_feature_looks">Pro தோற்றம்</string>
    <string name="pro_feature_looks_desc">முழு கருப்பு தீம் மற்றும் வால்பேப்பர் நிறங்கள்.</string>
    <string name="pro_feature_visualizer">முழுத்திரை விஷுவலைசர்</string>
    <string name="pro_feature_visualizer_desc">உங்கள் இசையுடன் நகரும் பார்கள் அல்லது வளையம்.</string>
    <string name="tip_title">டெவலப்பருக்கு ஒரு டீ வாங்குங்கள்</string>
    <string name="tip_desc">டிப்ஸ் கட்டாயமில்லை, கூடுதலாக எதையும் திறக்காது. Ampli-ஐ குறைந்த விளம்பரங்களுடனும் புதுப்பித்தும் வைக்க உதவும்.</string>
    <string name="tip_small">டீ %1$s</string>
    <string name="tip_large">டீ மற்றும் சமோசா %1$s</string>
    <string name="tip_unavailable">இப்போது டிப்ஸ் கிடைக்கவில்லை. பிறகு முயற்சிக்கவும்.</string>
    <string name="tip_thanks">டீக்கு நன்றி!</string>
    <string name="trial_button">விளம்பரம் பாருங்கள், %1$d மணி நேரம் Pro இலவசமாக முயற்சிக்கவும்</string>
    <string name="trial_active">Pro சோதனை %1$s வரை செயலில் உள்ளது</string>
    <string name="trial_started">Pro 24 மணி நேரத்திற்குத் திறக்கப்பட்டது. மகிழுங்கள்!</string>
    <string name="trial_no_ad">இப்போது விளம்பரம் கிடைக்கவில்லை. பிறகு முயற்சிக்கவும்.</string>
