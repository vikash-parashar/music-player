<?xml version="1.0" encoding="utf-8"?>
<!-- Clock + Music widget: time and date drawn by TextClock, so the launcher keeps them current. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextClock
        android:id="@+id/widget_clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:textColor="#FF9FE7DC"
        android:textSize="12sp" />
</LinearLayout>
